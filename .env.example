# Names only. Put real values in your host's secret settings (Railway → Variables),
# never in this file or the repository. Local development needs none of these.

# --- Hosting (apps/api/src/hosting.ts) ---
# The one public origin, https, no path. Until there is a domain, the host's own
# URL works, e.g. https://<service>.up.railway.app
RENOVAGENT_PUBLIC_URL=
# Set by the Dockerfile: RENOVAGENT_HOST=0.0.0.0, RENOVAGENT_STATIC_DIR=pages-dist.
# PORT is injected by Railway.

# --- Database (apps/api/src/database-config.ts) ---
# A production Atlas cluster, separate from development data.
MONGODB_URI=

# --- Sign-in (required for any public deployment) ---
# Callbacks default to <RENOVAGENT_PUBLIC_URL>/api/workspace/auth/{google,meta}/callback;
# register exactly those with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# --- Optional ---
# Catalog curation endpoints in account mode.
RENOVAGENT_CATALOG_OPERATOR=
# Photo analysis and design previews; also needs the `muse` CLI in the image.
MUSE_API_KEY=
