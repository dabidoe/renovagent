# Copy to .env and fill in. Never commit a real .env.
PORT=4000
NODE_ENV=development
# Railway: use the MongoDB plugin's connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/unpermitted
SESSION_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://127.0.0.1:8741
# Google sign-in (Firebase Admin service account). Leave blank to disable.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Node-only Muse execution; never prefix with VITE_ or put this key in client code.
MUSE_API_KEY=
