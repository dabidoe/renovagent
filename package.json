{
  "name": "renovagent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run check:boundaries && vite build && npm run build:foundation",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js && npm run test:foundation",
    "typecheck": "tsc --noEmit",
    "test:foundation": "node --import tsx --test tests/contracts/*.test.ts tests/domain/*.test.ts tests/integration/*.test.ts",
    "build:foundation": "vite build --config vite.foundation.config.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format:foundation": "prettier --write \"packages/**/*.ts\" \"apps/**/*.{ts,tsx,css}\" \"fixtures/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.{mjs,ts}\" vite.foundation.config.ts foundation.html",
    "format:check": "prettier --check \"packages/**/*.ts\" \"apps/**/*.{ts,tsx,css}\" \"fixtures/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.{mjs,ts}\" vite.foundation.config.ts foundation.html",
    "muse:photos": "node --import tsx scripts/muse-photo-review.ts",
    "muse:property": "node --import tsx scripts/muse-property-research.ts",
    "dev:api": "node --import tsx apps/api/src/server.ts",
    "serve:mcp": "node --import tsx apps/api/src/mcp.ts",
    "serve:mcp:http": "node --import tsx apps/api/src/mcp-http.ts",
    "mcp:access": "node --import tsx scripts/mcp-access.ts",
    "migrate:cluster": "node --import tsx scripts/migrate-to-cluster.ts",
    "dev:mongo": "node --import tsx scripts/local-mongo.ts",
    "dev:connected": "node --import tsx scripts/dev-connected.ts",
    "test:connected": "TEST_WORKSPACE_MONGO_URI=mongodb://127.0.0.1:27018/renovagent_workspace node --import tsx --test tests/integration/connected-workspace.test.ts tests/integration/mcp-workspace.test.ts tests/integration/mcp-http.test.ts tests/integration/cluster-migration.test.ts tests/integration/accounts.test.ts tests/integration/catalog.test.ts tests/integration/design-options.test.ts",
    "seed:catalog": "node --import tsx scripts/seed-catalog.ts",
    "build:pages": "npm run build && node scripts/package-pages.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "fake-indexeddb": "6.2.4",
    "mongodb-memory-server-core": "^11.3.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "firebase": "^13.1.0",
    "image-size": "^2.0.4",
    "jose": "^6.2.14",
    "mongodb": "^7.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
